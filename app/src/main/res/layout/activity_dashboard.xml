<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Dashboard Title -->
        <TextView
            android:id="@+id/dashboardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Weight Dashboard"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Goal Weight -->
        <TextView
            android:id="@+id/goalWeightLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Goal Weight: 180 lbs"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Weight History Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Weight History"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Table Headers -->
        <LinearLayout
            android:id="@+id/headerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="#E0E0E0">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Date"
                android:textColor="#000000"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Weight"
                android:textColor="#000000"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Action"
                android:textColor="#000000"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Saved weight entries appear here -->
        <LinearLayout
            android:id="@+id/weightHistoryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Message when no records exist -->
        <TextView
            android:id="@+id/historyEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No saved weight entries yet."
            android:gravity="center"
            android:padding="20dp"
            android:textSize="15sp" />

        <!-- Compatibility with existing DashboardActivity.
             This row will be replaced by database records. -->
        <LinearLayout
            android:id="@+id/sampleRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/sampleWeight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="--" />

            <Button
                android:id="@+id/buttonDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete" />
        </LinearLayout>

        <!-- Enter New Weight -->
        <EditText
            android:id="@+id/weightInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter weight in lbs"
            android:inputType="numberDecimal"
            android:layout_marginTop="25dp" />

        <!-- Add Weight Button -->
        <Button
            android:id="@+id/buttonAddWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Weight"
            android:layout_marginTop="12dp" />

        <!-- SMS Settings -->
        <Button
            android:id="@+id/buttonSmsSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notification Settings"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
